# Plantilla genérica — copia a .env.local para desarrollo contra un único
# proyecto Supabase (uso histórico, previo a la separación staging/producción
# de la Fase 2B). Para trabajar con "Personaliza tu portátil" usa en su lugar
# .env.staging.example o .env.production.example — ver docs/entornos-staging-produccion.md
#
# NUNCA pongas valores reales en este archivo (es el que se versiona en Git).

# Identifica en qué entorno corre la app (staging | production). A partir
# de la Fase 2B, un banner visible en el panel admin usa este valor para
# advertir cuando NO se está en production — ver docs/entornos-staging-produccion.md
NEXT_PUBLIC_APP_ENV=production

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional — bucket de Storage para imágenes de producto. Default: "products"
NEXT_PUBLIC_SUPABASE_BUCKET=

# Server-only. NUNCA con prefijo NEXT_PUBLIC_. Requerida a partir de la
# Fase 2B (Server Actions que escriben quote_requests).
SUPABASE_SERVICE_ROLE_KEY=

# Server-only, no es secreta — ver .env.staging.example para la explicación
# completa. La usa src/lib/env/environment.ts (assertNotProduction) para
# detectar si un script de staging terminó apuntando por error a producción.
SUPABASE_PROJECT_REF_PRODUCTION=

# ─────────────────────────────────────────────────────────────────────
# Meta / WhatsApp Embedded Signup — callback de onboarding
# TODAS server-only. NINGUNA puede llevar prefijo NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────
META_ONBOARDING_ENABLED=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
META_OAUTH_REDIRECT_URI=

# ─────────────────────────────────────────────────────────────────────
# Fase 3A — operación de WhatsApp Cloud API
# El onboarding y el webhook son rutas distintas. El webhook permanece
# apagado hasta que se complete el ledger/idempotencia de 3A.2.
# ─────────────────────────────────────────────────────────────────────
WHATSAPP_WEBHOOK_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
