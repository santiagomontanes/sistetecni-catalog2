# Plantilla genérica — copia a .env.local para desarrollo contra un único
# proyecto Supabase (uso histórico, previo a la separación staging/producción
# de la Fase 2B). Para trabajar con "Personaliza tu portátil" usa en su lugar
# .env.staging.example o .env.production.example — ver docs/entornos-staging-produccion.md
#
# NUNCA pongas valores reales en este archivo (es el que se versiona en Git).

# Identifica en qué entorno corre la app (staging | production). A partir
# de la Fase 2B, un banner visible en el panel admin usa este valor para
# advertir cuando NO se está en production — ver docs/entornos-staging-produccion.md
NEXT_PUBLIC_APP_ENV=production

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional — bucket de Storage para imágenes de producto. Default: "products"
NEXT_PUBLIC_SUPABASE_BUCKET=

# Server-only. NUNCA con prefijo NEXT_PUBLIC_. Requerida a partir de la
# Fase 2B (Server Actions que escriben quote_requests). No existe todavía
# ningún código que la use — se agrega aquí para que quede documentada
# desde ya y nadie la confunda con una variable de cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only, no es secreta — ver .env.staging.example para la explicación
# completa. La usa src/lib/env/environment.ts (assertNotProduction) para
# detectar si un script de staging terminó apuntando por error a producción.
SUPABASE_PROJECT_REF_PRODUCTION=

# ─────────────────────────────────────────────────────────────────────
# Meta / WhatsApp Embedded Signup — callback de onboarding
#
# TODAS server-only. NINGUNA puede llevar prefijo NEXT_PUBLIC_: el App
# Secret jamás debe entrar en el bundle del navegador. Los valores reales
# se configuran en Vercel (Project Settings → Environment Variables,
# scope Production), nunca en un archivo local ni en este repositorio.
# ─────────────────────────────────────────────────────────────────────

# Kill switch. La ruta /api/meta/whatsapp/callback y la página de
# resultado responden 404 salvo que valga EXACTAMENTE "true". Se despliega
# apagado; se enciende solo durante la ventana del onboarding.
META_ONBOARDING_ENABLED=

# ID de la app de Meta ("SISTETECNI Agente IA"). No es propiamente
# secreto, pero se mantiene server-only: no hay razón para publicarlo.
META_APP_ID=

# SECRETO. Se usa para intercambiar el authorization code server-side y
# para firmar/validar el `state`. Nunca se registra ni se devuelve.
META_APP_SECRET=

# Versión de Graph API con la forma "vNN.N". Por defecto v25.0.
META_GRAPH_API_VERSION=

# URI de redirección registrada en Meta. Además de documentarla, se usa
# como ORIGEN DE CONFIANZA para construir la redirección al resultado, de
# modo que el callback no pueda convertirse en un redirector abierto.
# Valor esperado: https://sistetecni.com/api/meta/whatsapp/callback
META_OAUTH_REDIRECT_URI=
