# Plantilla para el entorno PRODUCTION (proyecto Supabase real, el que ya
# usa la web hoy).
#
# En LOCAL casi nunca deberías necesitar esto — desarrollo y pruebas se
# hacen contra STAGING (.env.staging.example). Este archivo existe para
# documentar exactamente qué variables espera producción y evitar que
# alguien improvise nombres distintos al desplegar. Los valores reales de
# producción se configuran directamente en Vercel (Project Settings →
# Environment Variables, scope "Production"), NUNCA copiados a un archivo
# local ni a este repositorio. Ver docs/entornos-staging-produccion.md.

NEXT_PUBLIC_APP_ENV=production

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SUPABASE_BUCKET=products

# Server-only, en Vercel (scope Production), nunca en un archivo local
# nunca en Git, nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only, NO es secreta — mismo valor que en .env.staging.example (ver
# ese archivo para la explicación). Aquí, en el propio entorno de producción,
# esta variable coincidirá con el ref de NEXT_PUBLIC_SUPABASE_URL — es
# precisamente esa coincidencia la que assertNotProduction() usa para
# reconocer "esto es producción" y abortar si algo la invoca por error.
SUPABASE_PROJECT_REF_PRODUCTION=

# Fase 3A — el webhook operativo real sigue en sistetecni-ai-agent.
# Mantener esta ruta Vercel apagada para evitar dos receptores de Meta.
WHATSAPP_WEBHOOK_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0

# Fase 3B — API interna firmada agente local → ERP.
# NO habilitar hasta pasar STAGING. El secreto real se configura solo en
# Vercel Production y en el .env local del agente; nunca se copia a Git.
ERP_AGENT_CONTROL_ENABLED=false
ERP_AGENT_SHARED_SECRET=
ERP_AGENT_MAX_CLOCK_SKEW_SECONDS=300
