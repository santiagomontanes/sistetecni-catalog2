# Plantilla para el entorno STAGING (proyecto Supabase de prueba, D11).
#
# Copia este archivo a `.env.staging.local` y complétalo con los valores
# REALES de tu proyecto Supabase de STAGING — nunca los de producción.
# `.env.staging.local` está en .gitignore (patrón .env*.local) y NUNCA
# debe llegar a Git. Ver docs/entornos-staging-produccion.md para el
# procedimiento completo de cómo usar este archivo.
#
# STAGING solo debe contener datos ficticios/de prueba — nunca información
# real de clientes ni copias de datos de producción (ver docs/entornos-
# staging-produccion.md, sección "Qué NO hacer").

NEXT_PUBLIC_APP_ENV=staging

# URL y anon key del proyecto Supabase de STAGING (dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SUPABASE_BUCKET=products

# Server-only. Del proyecto de STAGING — nunca la de producción aquí.
# NUNCA con prefijo NEXT_PUBLIC_. Úsala solo desde código que corre en el
# servidor (Server Actions / Route Handlers, scripts de seed), nunca en un
# componente "use client".
SUPABASE_SERVICE_ROLE_KEY=

# Server-only, NO es secreta (es solo el subdominio de la URL de producción,
# ej. "abcdefgh" de https://abcdefgh.supabase.co — ya público en cualquier
# request a ese proyecto). Se usa ÚNICAMENTE como referencia de seguridad:
# assertNotProduction() la compara contra NEXT_PUBLIC_SUPABASE_URL para
# abortar si "staging" termina apuntando por error al proyecto real.
# Debe tener EL MISMO valor en los 3 archivos .env.*.example/.local — es el
# mismo dato ("cuál es el ref de producción"), sin importar en qué entorno
# se esté corriendo ahora mismo.
SUPABASE_PROJECT_REF_PRODUCTION=

# ─────────────────────────────────────────────────────────────────────
# Fase 3A — WhatsApp Cloud API (STAGING)
# El webhook operativo real lo atiende sistetecni-ai-agent. Esta ruta de
# Vercel queda apagada para evitar dos receptores compitiendo por Meta.
# ─────────────────────────────────────────────────────────────────────
WHATSAPP_WEBHOOK_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0

# ─────────────────────────────────────────────────────────────────────
# Página TEMPORAL de onboarding por Coexistence — /meta/coexistence
# (Embedded Signup con el Facebook JavaScript SDK). Ver
# docs/erp/12-coexistence-onboarding-temporal.md
# Kill switch server-only: solo "true" habilita la ruta; si no, 404.
META_COEXISTENCE_ENABLED=false
# Públicas (NEXT_PUBLIC_) porque el SDK corre en el navegador. NO son secretos.
# NUNCA poner aquí el App Secret ni tokens.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=
NEXT_PUBLIC_META_GRAPH_API_VERSION=v23.0

# ─────────────────────────────────────────────────────────────────────
# Fase 3B — API interna agente local → ERP web
# Server-only. El mismo ERP_AGENT_SHARED_SECRET debe existir en el agente
# local y aquí. Generar un secreto aleatorio >=32 caracteres; nunca Git.
# Mantener apagado hasta aplicar 20260829184500 en STAGING y registrar un
# operador ficticio/seguro para la prueba.
# ─────────────────────────────────────────────────────────────────────
ERP_AGENT_CONTROL_ENABLED=false
ERP_AGENT_SHARED_SECRET=
ERP_AGENT_MAX_CLOCK_SKEW_SECONDS=300
