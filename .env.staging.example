# Plantilla para el entorno STAGING (proyecto Supabase de prueba, D11).
#
# Copia este archivo a `.env.staging.local` y complétalo con los valores
# REALES de tu proyecto Supabase de STAGING — nunca los de producción.
# `.env.staging.local` está en .gitignore (patrón .env*.local) y NUNCA
# debe llegar a Git. Ver docs/entornos-staging-produccion.md para el
# procedimiento completo de cómo usar este archivo.
#
# STAGING solo debe contener datos ficticios/de prueba — nunca información
# real de clientes ni copias de datos de producción (ver docs/entornos-
# staging-produccion.md, sección "Qué NO hacer").

NEXT_PUBLIC_APP_ENV=staging

# URL y anon key del proyecto Supabase de STAGING (dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SUPABASE_BUCKET=products

# Server-only. Del proyecto de STAGING — nunca la de producción aquí.
# NUNCA con prefijo NEXT_PUBLIC_. Úsala solo desde código que corre en el
# servidor (Server Actions / Route Handlers), nunca en un componente
# "use client".
SUPABASE_SERVICE_ROLE_KEY=
