{
  "name": "sistetecni-catalog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "tarjeta:assets": "node scripts/generate-business-card-assets.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "test:operational:db": "node scripts/operational/db-local.mjs",
    "test:operational": "node scripts/operational/test-all.mjs",
    "test:operational:services": "node scripts/operational/browser-services.mjs",
    "test:operational:app": "node scripts/operational/browser-app.mjs",
    "test:operational:build": "node scripts/operational/build-local.mjs",
    "test:operational:e2e": "playwright test",
    "test:operational:crossrepo": "node --test scripts/operational/cross-repo.integration.mjs",
    "test:operational:scheduler": "node scripts/operational/scheduler-local-proof.mjs",
    "jobs:check": "node scripts/operational/run-jobs.mjs --check",
    "pilot:seed": "node scripts/operational/seed-pilot.mjs",
    "pilot:build": "node scripts/operational/pilot-build.mjs",
    "pilot:start": "node scripts/operational/pilot-server.mjs",
    "backup:local": "node scripts/operational/backup-local.mjs",
    "restore:local": "node scripts/operational/restore-local.mjs",
    "dev": "next dev",
    "build": "next build",
    "build:staging": "node scripts/build-staging.mjs",
    "start": "next start",
    "lint": "next lint",
    "env:staging": "node scripts/switch-env.mjs staging",
    "env:production": "node scripts/switch-env.mjs production",
    "seed:staging": "node scripts/seed-staging.mjs && node scripts/restore-b7-seed-stock.mjs",
    "seed:b7:restore": "node scripts/restore-b7-seed-stock.mjs",
    "test:env": "node --test src/lib/env/*.test.mjs",
    "test:b2": "tsc -p tsconfig.test.json && node --test .tmp-test/supabase .tmp-test/lib/repositories ; rm -rf .tmp-test",
    "test:b2:unit": "tsc -p tsconfig.test.json && node --test .tmp-test/supabase/admin.test.js .tmp-test/lib/repositories/repositories.unit.test.js ; rm -rf .tmp-test",
    "test:b3": "tsc -p tsconfig.test.json && node --test .tmp-test/lib/personalizador ; rm -rf .tmp-test",
    "test:b4": "tsc -p tsconfig.test.json && node --test .tmp-test/lib/personalizadorServer ; rm -rf .tmp-test",
    "test:b4:unit": "tsc -p tsconfig.test.json && node --test .tmp-test/lib/personalizadorServer/searchOptions.test.js .tmp-test/lib/personalizadorServer/createQuote.test.js .tmp-test/lib/personalizadorServer/mappers.test.js .tmp-test/lib/personalizadorServer/quoteLookup.test.js ; rm -rf .tmp-test",
    "test:b5": "tsc -p tsconfig.test.json && node --test .tmp-test/lib/personalizadorUi ; rm -rf .tmp-test",
    "test:catalogpdf": "tsc -p tsconfig.test.json && node --test .tmp-test/lib/catalogPdf ; rm -rf .tmp-test",
    "test:b6": "tsc -p tsconfig.test.json && node --test .tmp-test/lib/personalizadorAdmin ; rm -rf .tmp-test",
    "test:b7": "tsc -p tsconfig.test.json && node --test .tmp-test/lib/b7 ; rm -rf .tmp-test",
    "test:meta": "tsc -p tsconfig.test.json && node --test .tmp-test/lib/meta ; rm -rf .tmp-test",
    "test:coexistence-proxy": "tsc -p tsconfig.test.json && node --test .tmp-test/lib/meta/coexistenceProxy.test.js ; rm -rf .tmp-test",
    "test:ventas": "tsc -p tsconfig.test.json && node --test .tmp-test/lib/salesAdmin .tmp-test/lib/salesPdf .tmp-test/lib/repositories/sales.repository.test.js ; rm -rf .tmp-test",
    "test:all": "tsc -p tsconfig.test.json && node --test .tmp-test ; rm -rf .tmp-test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.95.3",
    "firebase": "^11.3.1",
    "framer-motion": "^12.34.0",
    "jsqr": "1.4.0",
    "lucide-react": "^0.563.0",
    "next": "^15.1.9",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.10.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.1.7",
    "pg": "^8.13.3",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
